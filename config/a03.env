# Samsung Galaxy A03 / qogirl6 / UMS9230
SOURCE_REPOSITORY="https://github.com/a03corerooted-dev-ctrl/limitless_android_kernel_samsung_a03.git"
SOURCE_REF="limitless/dev"
DEFCONFIG="a03_cis_open_defconfig"
ARCH="arm64"
CROSS_COMPILE="aarch64-linux-android-"
CLANG_TRIPLE="aarch64-linux-gnu-"

# Match the exact release string embedded in the SM-A035FXXS9CYG1 vendor modules.
# CONFIG_LOCALVERSION stays empty as in the stock kernel config; Kbuild appends
# this explicit LOCALVERSION and does not add the automatic '+' suffix.
LOCALVERSION="-27193134-abA035FXXS9CYG1"
EXPECTED_KERNEL_RELEASE="4.14.199-27193134-abA035FXXS9CYG1"
STOCK_MODULE_LAYOUT_CRC="0xe5881461"
